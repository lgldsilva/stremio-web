STREMIO_HTTP_PORT=8085
WEBUI_INTERNAL_PORT=8080

# Public URL used by stremio-web to call the bundled streaming server.
STREMIO_PUBLIC_URL=https://stremio.raspberrypi.lan/
STREMIO_PUBLIC_HOST=stremio.raspberrypi.lan
STREMIO_HOST_IP=host-gateway

# Keep empty when TLS is terminated by reverse proxy (recommended).
# Set an IPv4 only if you want the container itself to run HTTPS with stremio.rocks cert helper.
STREMIO_IPADDRESS=

STREMIO_AUTO_SERVER_URL=0
NO_CORS=1

# auto detects: nvidia -> vaapi -> none
HWACCEL_BACKEND=auto
NVIDIA_COMPAT_PATCH=1

# Torrent client integration (optional)
# Leave TORRENT_CLIENT_URL empty to disable the "Queue download" button.
# Supported types: transmission (more can be added in torrent-client-proxy.js)
TORRENT_CLIENT_URL=
TORRENT_CLIENT_TYPE=transmission
# Directory inside the torrent client container where downloads are saved.
# Used to save subtitles alongside the download. Must be accessible by both containers.
TORRENT_CLIENT_DOWNLOAD_DIR=

# NVIDIA-only compose override values
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,video,utility
